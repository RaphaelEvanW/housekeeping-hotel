# Local development only. These example passwords are not production credentials.
POSTGRES_DEV_PASSWORD=local_dev_only
POSTGRES_TEST_PASSWORD=local_test_only
DATABASE_URL=postgresql://housekeeping_dev:local_dev_only@127.0.0.1:5433/housekeeping_dev
TEST_DATABASE_URL=postgresql://housekeeping_test:local_test_only@127.0.0.1:5434/housekeeping_test

# Optional absolute persistent photo directory; default: <project>/.data/item-photos
# ITEM_PHOTO_DIR=D:/HousekeepingData/item-photos

# Password for four local development accounts: npm.cmd run dev:users
# Set a private password (12–128 characters) in .env.local before running.
DEV_TEST_USERS_PASSWORD=
