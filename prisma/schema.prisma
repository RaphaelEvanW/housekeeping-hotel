generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Core auth fields follow Better Auth 1.7.7's getAuthTables and Prisma adapter.
// Auth IDs are opaque strings: do not constrain them to PostgreSQL UUIDs.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  roles         UserRole[]
  auditEvents   AuditEvent[]
  itemsCreated  Item[] @relation("ItemCreatedBy")
  itemsUpdated  Item[] @relation("ItemUpdatedBy")
  unitsCreated ItemUnit[] @relation("ItemUnitCreatedBy")
  unitsUpdated ItemUnit[] @relation("ItemUnitUpdatedBy")
  stockBatches StockBatch[]

  itemDeactivationRequests  ItemDeactivationRequest[] @relation("ItemDeactivationRequestedBy")
  itemDeactivationDecisions ItemDeactivationRequest[] @relation("ItemDeactivationDecidedBy")
  guestVisitsCreated GuestVisit[] @relation("GuestVisitCreatedBy")
  guestVisitsUpdated GuestVisit[] @relation("GuestVisitUpdatedBy")
  borrowingsIssued Borrowing[] @relation("BorrowingIssuedBy")
  returnBatchesReceived ReturnBatch[] @relation("ReturnBatchReceivedBy")

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt   DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt  DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

enum RoleCode {
  HK_STAFF
  HK_SUPERVISOR
  MANAGEMENT
  SYSTEM_ADMIN
}

model Role {
  id        String     @id @default(uuid())
  code      RoleCode   @unique
  name      String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  users     UserRole[]

  @@map("role")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model Location {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  units     ItemUnit[]
  returnBatchesDefault ReturnBatch[] @relation("ReturnBatchDefaultLocation")
  returnLines          ReturnLine[] @relation("ReturnLineLocation")

  @@map("location")
}

model Item {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  description    String?
  photoKey       String? // First-photo cover retained for existing clients.
  isActive       Boolean  @default(true)
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  createdBy User @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("ItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  units     ItemUnit[]
  stockBatches StockBatch[]
  deactivationRequests ItemDeactivationRequest[]
  photos ItemPhoto[]

  @@index([isActive, name])
  @@map("item")
}

model ItemPhoto {
  id        String   @id @default(uuid())
  itemId    String
  photoKey  String   @unique
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([itemId, position])
  @@map("item_photo")
}

enum UnitLifecycle {
  ACTIVE
  RETIRED
}

enum UnitCustody {
  HOUSEKEEPING
  GUEST
  ENGINEERING
  EXTERNAL_VENDOR
}

enum UnitCondition {
  GOOD
  MINOR_DAMAGE
  DAMAGED
  MISSING_PART
}

enum UnitReadiness {
  CLEAR
  ON_HOLD
  PENDING_INSPECTION
  PENDING_VERIFICATION
}

enum UnitLossState {
  NONE
  MISSING
  LOST
}

model ItemUnit {
  id           String        @id @default(uuid())
  unitNumber   Int           @unique @default(autoincrement())
  itemId       String
  stockBatchId String?
  name         String?
  serialNumber String?
  notes        String?

  lifecycle    UnitLifecycle @default(ACTIVE)
  custody      UnitCustody   @default(HOUSEKEEPING)
  condition    UnitCondition @default(GOOD)
  readiness    UnitReadiness @default(CLEAR)
  lossState    UnitLossState @default(NONE)
  locationId   String?

  createdById  String
  updatedById  String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User      @relation("ItemUnitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User      @relation("ItemUnitUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  stockBatch StockBatch? @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  photos ItemUnitPhoto[]
  borrowingLines BorrowingLine[]
  
  @@index([itemId])
  @@index([locationId])
  @@index([stockBatchId])
  @@map("item_unit")
}

model StockBatch {
  id          String   @id
  itemId      String
  quantity    Int
  requestHash String
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  units     ItemUnit[]

  @@index([itemId, createdAt])
  @@index([createdById])
  @@map("stock_batch")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  reason     String?
  oldValues  Json?
  newValues  Json?
  photos ItemUnitPhoto[]
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_event")
}


enum ItemDeactivationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ItemDeactivationRequest {
  id            String                  @id @default(uuid())
  itemId        String
  status        ItemDeactivationStatus  @default(PENDING)
  reason        String
  requestedById String
  decidedById   String?
  decidedAt     DateTime?               @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)

  item        Item  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requestedBy User  @relation("ItemDeactivationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ItemDeactivationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([status, createdAt])
  @@index([requestedById])
  @@index([decidedById])
  @@map("item_deactivation_request")
}

enum GuestVisitStatus {
  STAYING
  CHECKED_OUT
}

model GuestVisit {
  id                         String           @id @default(uuid())
  primaryGuestName           String
  normalizedPrimaryGuestName String
  roomNumber                 String
  bookingNumber              String?
  registrationRequestHash    String?          @db.Char(64)
  checkInDate                DateTime         @db.Date
  plannedCheckoutDate        DateTime         @db.Date
  status                     GuestVisitStatus @default(STAYING)
  checkedOutAt               DateTime?        @db.Timestamptz(3)
  isDuplicate                Boolean          @default(false)

  createdById String
  updatedById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  createdBy User @relation("GuestVisitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("GuestVisitUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  borrowings Borrowing[]
  returnBatches ReturnBatch[]

  @@index([status, roomNumber, checkInDate])
  @@index([normalizedPrimaryGuestName, status, checkInDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("guest_visit")
}

model ItemUnitPhoto {
  id           String @id @default(uuid())
  unitId       String
  auditEventId String
  borrowingLineId String?
  returnLineId String?
  photoKey     String @unique

  unit       ItemUnit   @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvent AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  borrowingLine BorrowingLine? @relation(fields: [borrowingLineId, unitId], references: [id, unitId], onDelete: Restrict, onUpdate: Restrict)
  returnLine ReturnLine? @relation(fields: [returnLineId, borrowingLineId], references: [id, borrowingLineId], onDelete: Restrict, onUpdate: Restrict)

  @@index([unitId])
  @@index([auditEventId])
  @@index([borrowingLineId])
  @@index([returnLineId, borrowingLineId])
  @@map("item_unit_photo")
}

enum BorrowingLineStatus {
  OUTSTANDING
  RETURNED
  SETTLED
}

model Borrowing {
  id                       String   @id @default(uuid())
  guestVisitId             String
  requestHash              String   @db.Char(64)
  primaryGuestNameSnapshot String
  roomNumberSnapshot       String
  issuedById               String
  issuedAt                 DateTime @default(now()) @db.Timestamptz(3)

  guestVisit GuestVisit @relation(fields: [guestVisitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy   User       @relation("BorrowingIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines      BorrowingLine[]

  @@index([guestVisitId, issuedAt])
  @@index([issuedById])
  @@map("borrowing")
}

model BorrowingLine {
  id               String              @id @default(uuid())
  borrowingId      String
  unitId           String
  conditionAtIssue UnitCondition
  status           BorrowingLineStatus @default(OUTSTANDING)
  resolvedAt       DateTime?           @db.Timestamptz(3)

  borrowing Borrowing @relation(fields: [borrowingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      ItemUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  photos    ItemUnitPhoto[]
  returnLine ReturnLine?

  @@unique([borrowingId, unitId])
  @@unique([id, unitId])
  @@index([unitId])
  @@map("borrowing_line")
}

model ReturnBatch {
  id                String   @id @default(uuid())
  guestVisitId      String
  requestHash       String   @db.Char(64)
  defaultLocationId String
  receivedById      String
  receivedAt        DateTime @default(now()) @db.Timestamptz(3)

  guestVisit      GuestVisit @relation(fields: [guestVisitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  defaultLocation Location   @relation("ReturnBatchDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receivedBy      User       @relation("ReturnBatchReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines           ReturnLine[]

  @@index([guestVisitId, receivedAt])
  @@index([defaultLocationId])
  @@index([receivedById])
  @@map("return_batch")
}

model ReturnLine {
  id              String        @id @default(uuid())
  returnBatchId   String
  borrowingLineId String        @unique
  condition       UnitCondition @default(GOOD)
  locationId      String

  returnBatch   ReturnBatch   @relation(fields: [returnBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  borrowingLine BorrowingLine @relation(fields: [borrowingLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location      Location      @relation("ReturnLineLocation", fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  photos        ItemUnitPhoto[]

  @@unique([id, borrowingLineId])
  @@index([returnBatchId])
  @@index([locationId])
  @@map("return_line")
}