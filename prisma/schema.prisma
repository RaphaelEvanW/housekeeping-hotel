generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Core auth fields follow Better Auth 1.7.7's getAuthTables and Prisma adapter.
// Auth IDs are opaque strings: do not constrain them to PostgreSQL UUIDs.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  roles         UserRole[]
  auditEvents   AuditEvent[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt   DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt  DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

enum RoleCode {
  HK_STAFF
  HK_SUPERVISOR
  MANAGEMENT
  SYSTEM_ADMIN
}

model Role {
  id        String     @id @default(uuid())
  code      RoleCode   @unique
  name      String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  users     UserRole[]

  @@map("role")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model Location {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("location")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  reason     String?
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_event")
}
